---
import SectionHeading from "./SectionHeading.astro";
import type { SectionLabel, SkillGroup } from "../types/portfolio";

interface Props {
	skillGroups: SkillGroup[];
	label: SectionLabel;
}

const { skillGroups, label } = Astro.props;
---

<section class="section-block" id="skills">
	<SectionHeading {...label} />
	<div class="card-grid card-grid-three">
		{
			skillGroups.map((group) => (
				<article class="panel feature-card">
					<h3>{group.name}</h3>
					<p>{group.summary}</p>
					<ul class="pill-list">
						{group.skills.map((skill) => <li>{skill}</li>)}
					</ul>
				</article>
			))
		}
	</div>
</section>
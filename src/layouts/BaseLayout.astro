---
import "../styles/global.css";
import type { NavigationLink, SiteMeta } from "../types/portfolio";

interface Props {
	metadata: SiteMeta;
	navigation: NavigationLink[];
}

const { metadata, navigation } = Astro.props;
const currentYear = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metadata.description} />
		<meta name="generator" content={Astro.generator} />
		<title>{metadata.title}</title>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<a class="brand" href="/">{metadata.shortTitle}</a>
				<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
					<svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<line x1="3" y1="6" x2="21" y2="6"/>
						<line x1="3" y1="12" x2="21" y2="12"/>
						<line x1="3" y1="18" x2="21" y2="18"/>
					</svg>
					<svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
				<nav id="primary-nav" aria-label="Primary navigation">
					<ul class="nav-list">
						{
							navigation.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
					</ul>
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<footer class="site-footer">
				<p>{metadata.shortTitle}</p>
				<p>Engineering Leader · iOS · Mobile Architecture</p>
				<p>{currentYear}</p>
			</footer>
		</div>
		<script>
			const toggle = document.querySelector('.menu-toggle');
			const nav = document.getElementById('primary-nav');

			function closeMenu() {
				if (!nav || !toggle) return;
				nav.classList.remove('is-open');
				toggle.classList.remove('is-open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', 'Open navigation');
			}

			if (toggle && nav) {
				toggle.addEventListener('click', () => {
					const isOpen = nav.classList.toggle('is-open');
					toggle.classList.toggle('is-open', isOpen);
					toggle.setAttribute('aria-expanded', String(isOpen));
					toggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
				});

				nav.querySelectorAll('a').forEach((link) => {
					link.addEventListener('click', closeMenu);
				});
			}
		</script>
	</body>
</html>
---
import SectionHeading from "./SectionHeading.astro";
import type { ProjectHighlight } from "../types/portfolio";

interface Props {
	projects: ProjectHighlight[];
}

const { projects } = Astro.props;
---

<section class="section-block" id="projects">
	<SectionHeading
		eyebrow="Selected work"
		title="Featured work"
		intro="A selection of roles where I owned both the architecture and the outcome."
	/>
	<div class="card-grid">
		{
			projects.map((project) => (
				<article class="panel project-card">
					<div class="project-header">
						<h3>{project.name}</h3>
						{project.href && project.linkLabel && (
							<a class="text-link" href={project.href}>{project.linkLabel}</a>
						)}
					</div>
					<p>{project.summary}</p>
					<p class="project-impact">{project.impact}</p>
					<ul class="pill-list">
						{project.stack.map((item) => <li>{item}</li>)}
					</ul>
				</article>
			))
		}
	</div>
</section>
---
import "../styles/global.css";
import type { NavigationLink, SiteMeta } from "../types/portfolio";
import { languages, languageFlags, localePaths, type Lang } from "../i18n/index";

interface Props {
	metadata: SiteMeta;
	navigation: NavigationLink[];
	footerTagline: string;
	footerSource: string;
}

const { metadata, navigation, footerTagline, footerSource } = Astro.props;
const currentYear = new Date().getFullYear();
const currentLang = metadata.lang as Lang;
---

<html lang={metadata.lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={metadata.description} />
		<meta name="generator" content={Astro.generator} />
		<title>{metadata.title}</title>
		<link rel="alternate" hreflang="en" href="/" />
		<link rel="alternate" hreflang="es" href="/es/" />
		<link rel="alternate" hreflang="pt" href="/pt/" />
		<link rel="alternate" hreflang="x-default" href="/" />
		<script is:inline>
			// Redirect first-time visitors to their browser language if supported.
			(function () {
				var PREF_KEY = 'lang-pref';
				var lang = document.documentElement.lang;
				if (lang !== 'en') return; // already on a non-default locale
				var stored = localStorage.getItem(PREF_KEY);
				if (stored === 'es') { window.location.replace('/es/'); return; }
				if (stored === 'pt') { window.location.replace('/pt/'); return; }
				if (!stored) {
					var bl = (navigator.language || '').slice(0, 2).toLowerCase();
					if (bl === 'es') { localStorage.setItem(PREF_KEY, 'es'); window.location.replace('/es/'); }
					else if (bl === 'pt') { localStorage.setItem(PREF_KEY, 'pt'); window.location.replace('/pt/'); }
				}
			})();
		</script>
	</head>
	<body>
		<div class="page-shell">
			<header class="site-header">
				<a class="brand" href={localePaths[currentLang]}>{metadata.shortTitle}</a>
				<button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="primary-nav">
					<svg class="icon-menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<line x1="3" y1="6" x2="21" y2="6"/>
						<line x1="3" y1="12" x2="21" y2="12"/>
						<line x1="3" y1="18" x2="21" y2="18"/>
					</svg>
					<svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<line x1="18" y1="6" x2="6" y2="18"/>
						<line x1="6" y1="6" x2="18" y2="18"/>
					</svg>
				</button>
				<nav id="primary-nav" aria-label="Primary navigation">
					<ul class="nav-list">
						{
							navigation.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))
						}
						<li class="lang-switcher-item">
							<button class="lang-trigger" aria-haspopup="listbox" aria-expanded="false" aria-label="Select language">
								<span class="lang-flag" aria-hidden="true">{languageFlags[currentLang]}</span>
								<span class="lang-code">{currentLang.toUpperCase()}</span>
								<svg class="lang-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="2 4 6 8 10 4"/>
								</svg>
							</button>
							<ul class="lang-dropdown" role="listbox" aria-label="Language">
								{
									(Object.keys(languages) as Lang[]).map((lang) => (
										<li role="presentation">
											<a
												href={localePaths[lang]}
												class="lang-option"
												data-set-lang={lang}
												hreflang={lang}
												role="option"
												aria-selected={lang === currentLang ? "true" : "false"}
											>
												<span class="lang-flag" aria-hidden="true">{languageFlags[lang]}</span>
												{languages[lang]}
											</a>
										</li>
									))
								}
							</ul>
						</li>
					</ul>
				</nav>
			</header>
			<main>
				<slot />
			</main>
			<footer class="site-footer">
				<p>{metadata.shortTitle}</p>
				<p>{footerTagline}</p>
				<p>
					<a href="https://github.com/jjrebollo/portfolio" target="_blank" rel="noopener noreferrer" class="footer-source-link">
						{footerSource}
					</a>
				</p>
				<p>{currentYear}</p>
			</footer>
		</div>
		<script>
			const toggle = document.querySelector('.menu-toggle');
			const nav = document.getElementById('primary-nav');

			function closeMenu() {
				if (!nav || !toggle) return;
				nav.classList.remove('is-open');
				toggle.classList.remove('is-open');
				toggle.setAttribute('aria-expanded', 'false');
				toggle.setAttribute('aria-label', 'Open navigation');
			}

			if (toggle && nav) {
				toggle.addEventListener('click', () => {
					const isOpen = nav.classList.toggle('is-open');
					toggle.classList.toggle('is-open', isOpen);
					toggle.setAttribute('aria-expanded', String(isOpen));
					toggle.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
				});

				nav.querySelectorAll('a[href^="#"]').forEach((link) => {
					link.addEventListener('click', closeMenu);
				});
			}

			// Store language preference when user explicitly switches language,
			// and preserve the current section anchor.
			document.querySelectorAll<HTMLAnchorElement>('[data-set-lang]').forEach((el) => {
				el.addEventListener('click', (e) => {
					e.preventDefault();
					const lang = el.dataset.setLang;
					if (lang) localStorage.setItem('lang-pref', lang);
					window.location.assign(el.href + window.location.hash);
				});
			});

			// Language dropdown toggle.
			const langTrigger = document.querySelector<HTMLButtonElement>('.lang-trigger');
			const langDropdown = document.querySelector<HTMLElement>('.lang-dropdown');

			if (langTrigger && langDropdown) {
				langTrigger.addEventListener('click', (e) => {
					e.stopPropagation();
					const isOpen = langDropdown.classList.toggle('is-open');
					langTrigger.setAttribute('aria-expanded', String(isOpen));
				});

				document.addEventListener('click', () => {
					langDropdown.classList.remove('is-open');
					langTrigger.setAttribute('aria-expanded', 'false');
				});

				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape') {
						langDropdown.classList.remove('is-open');
						langTrigger.setAttribute('aria-expanded', 'false');
						langTrigger.focus();
					}
				});
			}
		</script>
	</body>
</html>
---
import type { HeroContent } from "../types/portfolio";

interface Props {
	hero: HeroContent;
	cvHref?: string;
}

const { hero, cvHref } = Astro.props;
---

<section class="hero section-block" id="top">
	<div class="hero-copy panel panel-hero">
		<p class="section-eyebrow">{hero.eyebrow}</p>
		<h1>{hero.title}</h1>
		<p class="hero-summary">{hero.summary}</p>
		<div class="hero-actions">
			<a class="button button-primary" href={hero.primaryAction.href}>{hero.primaryAction.label}</a>
			<a class="button button-secondary" href={hero.secondaryAction.href}>{hero.secondaryAction.label}</a>
			{cvHref && (
				<a class="button button-download" href={cvHref} download="Juan_Rebollo_CV.pdf">
					<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
						<polyline points="7 10 12 15 17 10"/>
						<line x1="12" y1="15" x2="12" y2="3"/>
					</svg>
					Download CV
				</a>
			)}
		</div>
	</div>
	<div class="hero-metrics panel">
		<ul class="metric-grid">
			{
				hero.metrics.map((metric) => (
					<li class="metric-card">
						<strong>{metric.value}</strong>
						<span>{metric.label}</span>
					</li>
				))
			}
		</ul>
	</div>
</section>